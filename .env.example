# Browser-safe values only. These are public project identifiers/keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Never add Infinite Flight client secrets, access/refresh tokens, Discord bot tokens,
# Supabase service-role keys, or encryption keys to VITE_ variables.

# Public browser key for MapTiler vector map styles used by MapLibre GL JS.
# Restrict this key to your production Vercel domain in the MapTiler dashboard.
VITE_MAPTILER_API_KEY=
